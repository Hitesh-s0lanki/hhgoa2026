# The origin this deployment is reachable at, absolute and public.
#
# This is the one variable that must be right before anyone shares. X builds
# the image preview by fetching /share/[id] and reading its og:image, so this
# has to be an address X's crawler can actually open. Left at localhost, the
# app falls back to posting the card image URL directly — which is public, but
# arrives as a bare link with no preview card.
#
#   local        http://localhost:3002
#   preview      https://<branch>.vercel.app
#   production   https://hhgoa.app
NEXT_PUBLIC_SITE_URL=http://localhost:3002

NEXT_PUBLIC_SHARE_HASHTAG=FrameInGoa

# Neon Postgres — where a generated pass is recorded so /share/[id] can resolve
# it. Use the *pooled* connection string from the Neon console (it ends in
# `-pooler`); the driver is neon-http, which needs no pool of its own but is
# routed through the same endpoint.
#   npm run db:migrate    applies drizzle/*.sql
# Leave blank locally: posting to X degrades with a clear message, and Download
# keeps working because it never touches a server.
DATABASE_URL=

# UploadThing — stores the source photo and the rendered card PNGs.
# One token from https://uploadthing.com/dashboard → API Keys.
# Leave blank and both upload paths fail loudly; Download still works.
UPLOADTHING_TOKEN=
